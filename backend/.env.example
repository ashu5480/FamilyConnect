# Backend environment variables
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net
MONGODB_DB_NAME=FamilyConnectMobile
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI / Background Removal
AI_API_KEY=your-ai-api-key
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Background removal
BACKGROUND_REMOVAL_PROVIDER=removebg
REMOVEBG_API_KEY=your-removebg-api-key

# Media storage
BLOB_STORAGE_PROVIDER=vercel-blob
CLOUDINARY_URL=cloudinary://your-key:your-secret@cloud-name
BLOB_READ_ACCESS_TOKEN=your-vercel-blob-token

# Vercel
VERCEL_ENV=development

# Push notifications
EXPO_ACCESS_TOKEN=your-expo-access-token
FCM_SERVER_KEY=your-fcm-server-key

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100