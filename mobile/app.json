{
  "name": "familyconnect",
  "slug": "familyconnect",
  "version": "1.0.0",
  "orientation": "portrait",
  "userInterfaceStyle": "light",
  "scheme": "familyconnect",
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.familyconnect.app",
    "infoPlist": {
      "NSCameraUsageDescription": "FamilyConnect needs access to your camera to take photos for events.",
      "NSPhotoLibraryUsageDescription": "FamilyConnect needs access to your photo library to upload event photos.",
      "NSMicrophoneUsageDescription": "FamilyConnect needs microphone access for voice messages."
    }
  },
  "android": {
    "package": "com.familyconnect.app",
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#FFFFFF"
    },
    "permissions": [
      "android.permission.CAMERA",
      "android.permission.READ_EXTERNAL_STORAGE",
      "android.permission.WRITE_EXTERNAL_STORAGE",
      "android.permission.RECORD_AUDIO",
      "android.permission.CAMERA",
      "android.permission.READ_EXTERNAL_STORAGE",
      "android.permission.WRITE_EXTERNAL_STORAGE",
      "android.permission.RECORD_AUDIO"
    ]
  },
  "web": {
    "bundler": "metro",
    "output": "static",
    "favicon": "./assets/favicon.png"
  },
  "updates": {
    "url": "https://u.expo.dev/807e3be6-940a-468f-b634-5a71aa35451d",
    "fallbackToCacheTimeout": 0,
    "checkAutomatically": "ON_LOAD"
  },
  "runtimeVersion": {
    "policy": "appVersion"
  },
  "extra": {
    "eas": {
      "projectId": "807e3be6-940a-468f-b634-5a71aa35451d"
    }
  },
  "plugins": [
    "expo-image-picker",
    "expo-secure-store",
    "expo-notifications"
  ],
  "experiments": {
    "typedRoutes": true
  },
  "owner": "singhashu772s-team"
}
